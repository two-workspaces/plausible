<clickhouse>
    <!-- Railway collects stdout; the stock config writes trace-level logs to
         /var/log/clickhouse-server (up to 10 GB) on the container disk. The
         files stay (the image's entrypoint looks them up) but tiny. -->
    <logger>
        <level>warning</level>
        <console>1</console>
        <size>10M</size>
        <count>1</count>
    </logger>

    <!-- ClickHouse's own telemetry tables grow without a TTL and write every
         few seconds. query_log (30 days, as in Plausible CE) and crash_log stay. -->
    <query_log replace="1">
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
        <engine>
            ENGINE = MergeTree
            PARTITION BY event_date
            ORDER BY (event_time)
            TTL event_date + interval 30 day
            SETTINGS ttl_only_drop_parts=1
        </engine>
    </query_log>
    <session_log remove="remove"/>
    <trace_log remove="remove"/>
    <text_log remove="remove"/>
    <metric_log remove="remove"/>
    <query_metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <processors_profile_log remove="remove"/>
    <part_log remove="remove"/>
    <query_thread_log remove="remove"/>
    <query_views_log remove="remove"/>
    <background_schedule_pool_log remove="remove"/>
    <error_log remove="remove"/>
    <latency_log remove="remove"/>
    <opentelemetry_span_log remove="remove"/>
    <asynchronous_insert_log remove="remove"/>
    <blob_storage_log remove="remove"/>
    <s3queue_log remove="remove"/>
    <backup_log remove="remove"/>
    <iceberg_metadata_log remove="remove"/>
    <delta_lake_metadata_log remove="remove"/>
</clickhouse>
